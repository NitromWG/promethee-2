// Fichier modèle : cmake/version.cmake en tire promethee.rc (icône et propriétés du fichier Windows).
#pragma code_page(65001)
#include <winver.h>

IDI_ICON1 ICON "@SOURCE_DIR@/app/ressources/promethee.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_MAJEURE@,@VERSION_MINEURE@,@VERSION_CORRECTIVE@,@NUMERO_BUILD@
 PRODUCTVERSION @VERSION_MAJEURE@,@VERSION_MINEURE@,@VERSION_CORRECTIVE@,@NUMERO_BUILD@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Projet Prométhée"
      VALUE "FileDescription", "Prométhée, plateforme libre d’ingénierie intégrée"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "Promethee"
      VALUE "LegalCopyright", "© 2026 les contributeurs de Prométhée, licence GPL-3.0-only"
      VALUE "OriginalFilename", "Promethee.exe"
      VALUE "ProductName", "Prométhée"
      VALUE "ProductVersion", "@IDENTIFIANT@"
      VALUE "Comments", "Révision des sources @REVISION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
