{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nitromwg.github.io/promethee/schemas/schemas/projet-0.28.schema.json",
  "title": "Projet Prométhée écrit pour la 0.28",
  "description": "Ce que la 0.28 écrit (format électronique 1, sans clé de format) : en plus de ce que la 0.29 n'a pas, ni profil de fabricant personnalisé, ni brochage vérifié, ni exclusion de la nomenclature ou du placement, ni couches explicites des pastilles. Les textes de carte y tournent dans le sens inverse des empreintes.",
  "allOf": [{ "$ref": "../schema_projet.json#/$defs/projet" }],
  "not": { "required": ["dispositions"] },
  "properties": {
    "version": { "const": 3 },
    "electronique": { "items": { "$ref": "#/$defs/conception" } }
  },
  "$defs": {
    "conception": {
      "allOf": [{ "$ref": "../schema_conception.json#/$defs/conception" }],
      "not": { "anyOf": [{ "required": ["format"] }, { "required": ["formatElectronique"] }, { "required": ["schemaSeul"] }] },
      "properties": {
        "composants": {
          "items": { "not": { "anyOf": [{ "required": ["brochageVerifie"] }, { "required": ["horsNomenclature"] }, { "required": ["horsPlacement"] }] } }
        },
        "feuilles": {
          "items": {
            "properties": {
              "jonctions": { "items": { "maxItems": 2 } },
              "nonConnexions": { "items": { "maxItems": 2 } }
            }
          }
        },
        "bibliothequeEmpreintes": {
          "items": { "properties": { "pastilles": { "items": { "not": { "required": ["couches"] } } } } }
        },
        "circuit": {
          "properties": { "regles": { "not": { "required": ["capacitesPerso"] } } }
        }
      }
    }
  }
}
