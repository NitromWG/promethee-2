{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nitromwg.github.io/promethee/schemas/schema_conception.json",
  "title": "Conception électronique de Prométhée, format 5 (fichiers de la 0.33)",
  "description": "Une carte électronique dans le fichier de projet (.prom) : schéma, composants, définitions de symboles et d'empreintes figées, circuit imprimé. Coordonnées et longueurs en nanomètres entiers. Chaque objet peut porter des clés qu'il ne connaît pas (écrites par une version plus récente) : elles sont gardées et réécrites telles quelles (ECH-11). La racine décrit le fichier de la 0.32 ; $defs/conception décrit la structure commune aux versions 0.28 à 0.32, que les schémas de docs/schemas restreignent.",
  "allOf": [{ "$ref": "#/$defs/conception" }],
  "required": ["format", "formatElectronique"],
  "properties": {
    "format": { "const": 5, "description": "Format de la conception (ECH-10) : 2 pour la 0.30, 3 pour la 0.31, 4 pour la 0.32, 5 pour la 0.33." },
    "formatElectronique": { "const": 5, "description": "Même format, sous le nom que lit la 0.29 : sans lui, elle prendrait la carte pour une carte de la 0.28." }
  },
  "$defs": {
    "nm": { "type": "integer", "description": "Longueur ou coordonnée en nanomètres." },
    "point": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/nm" }, { "$ref": "#/$defs/nm" }], "minItems": 2, "maxItems": 2 },
    "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "pointIdentifie": {
      "description": "Point d'une jonction ou d'une marque de non-connexion : [x, y] ou [x, y, uuid] (0.30).",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/nm" }, { "$ref": "#/$defs/nm" }, { "type": "string" }],
      "minItems": 2,
      "maxItems": 3
    },
    "couche": {
      "type": "string",
      "enum": ["F.Cu", "In1.Cu", "In2.Cu", "B.Cu", "F.Mask", "B.Mask", "F.Paste", "B.Paste", "F.SilkS", "B.SilkS", "Edge.Cuts", "F.CrtYd", "B.CrtYd", "F.Fab", "B.Fab"]
    },
    "chaines": { "type": "object", "additionalProperties": { "type": "string" } },
    "conception": {
      "type": "object",
      "required": ["uuid", "nom", "cartouche", "composants", "feuilles", "symboles", "circuit"],
      "properties": {
        "uuid": { "type": "string" },
        "nom": { "type": "string" },
        "format": { "type": "integer", "minimum": 2 },
        "formatElectronique": { "type": "integer", "minimum": 2 },
        "pilotageBoitier": { "type": "boolean" },
        "schemaSeul": { "type": "boolean", "description": "Schéma sans circuit imprimé (0.30)." },
        "synchroSurConfirmation": { "type": "boolean", "description": "Les écarts sans risque entre le schéma et le circuit attendent une confirmation au lieu de s'appliquer d'eux-mêmes (0.32)." },
        "variables": { "$ref": "#/$defs/chaines", "description": "Variables de la conception, utilisables dans les formules des valeurs (0.32) : nom → grandeur (« 5V »)." },
        "articles": { "type": "array", "items": { "type": "object", "required": ["id"] }, "description": "Articles du projet (0.33) : symbole, empreinte, modèle 3D, sources et paramètres d'une pièce achetée, avec sa version, son état de cycle de vie (etatCycle) et son numéro interne (numeroInterne)." },
        "modeles3D": {
          "type": "array",
          "description": "Modèles 3D exacts (0.33) : B-rep OpenCascade en texte (brep), boîte englobante en nm [x0, y0, z0, x1, y1, z1], quarts de tour et réglage [dx, dy, dz].",
          "items": { "type": "object", "required": ["id", "nom", "boite", "brep"], "properties": { "id": { "type": "string" }, "nom": { "type": "string" }, "boite": { "type": "array", "minItems": 6, "maxItems": 6 }, "brep": { "type": "string" }, "quarts": { "type": "integer" }, "reglage": { "type": "array" } } }
        },
        "facades": {
          "type": "array",
          "description": "Façades du boîtier (0.33) : découpes rondes ou rectangulaires, légendes et échelles, chacune rattachée à un composant et décalée de lui (dx, dy).",
          "items": { "type": "object", "required": ["uuid", "nom", "elements"], "properties": { "elements": { "type": "array", "items": { "type": "object", "required": ["uuid", "genre"], "properties": { "genre": { "enum": ["decoupeRonde", "decoupeRect", "legende", "echelle"] } } } } } }
        },
        "esquisseContour": { "type": "object", "description": "Esquisse paramétrique qui pilote le contour de la carte (0.33)." },
        "variantesMontage": { "type": "array", "items": { "type": "object", "required": ["nom"], "properties": { "nom": { "type": "string" }, "description": { "type": "string" } } }, "description": "Variantes de montage (0.33) ; les surcharges sont portées par chaque composant (variantes)." },
        "varianteActive": { "type": "string", "description": "Variante montrée et utilisée par les sorties (0.33) ; absente : la carte de base." },
        "notes": {
          "type": "array",
          "description": "Notes attachées aux objets (0.33) : commentaires de revue, tâches et journal, en fil de discussion (parent).",
          "items": { "type": "object", "required": ["uuid", "genre", "texte"], "properties": { "genre": { "enum": ["commentaire", "tache", "journal"] }, "objet": { "type": "string" }, "parent": { "type": "string" }, "close": { "type": "boolean" }, "priorite": { "type": "integer" } } }
        },
        "jeuxSorties": {
          "type": "array",
          "description": "Jeux de sorties enregistrés (0.33) : dossier à variables ({projet}, {carte}, {revision}, {variante}, {date}, et celles données par -D CLE=VALEUR), liste de sorties, variante, archive zip, contrôles avant publication.",
          "items": { "type": "object", "required": ["nom", "dossier", "sorties"], "properties": { "nom": { "type": "string" }, "dossier": { "type": "string" }, "sorties": { "type": "array", "items": { "type": "string" } }, "variante": { "type": "string" }, "zip": { "type": "boolean" }, "controler": { "type": "boolean" } } }
        },
        "erc": {
          "type": "object",
          "description": "Réglages de l'ERC et de la DRC propres au projet (0.31) : gravité réglée par code, matrice des liaisons, alertes exclues avec leur raison.",
          "properties": {
            "gravites": { "type": "object", "additionalProperties": { "enum": ["erreur", "avertissement", "ignorer"] } },
            "matrice": { "$ref": "#/$defs/chaines" },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string" },
                  "objets": { "type": "array", "items": { "type": "string" } },
                  "raison": { "type": "string" },
                  "auteur": { "type": "string" },
                  "date": { "type": "string" },
                  "signature": { "type": "string", "description": "Empreinte des objets visés au moment de l'exclusion (0.33) : l'alerte revient « à revoir » si l'un d'eux bouge." }
                }
              }
            }
          }
        },
        "verrouillee": { "type": "boolean" },
        "publications": { "type": "array", "items": { "$ref": "#/$defs/publication" } },
        "cartouche": { "$ref": "#/$defs/cartouche" },
        "composants": { "type": "array", "items": { "$ref": "#/$defs/composant" } },
        "feuilles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feuille" } },
        "symboles": { "type": "array", "items": { "$ref": "#/$defs/defSymbole" } },
        "nomsReseaux": { "$ref": "#/$defs/chaines" },
        "bibliothequeEmpreintes": { "type": "array", "items": { "$ref": "#/$defs/defEmpreinte" } },
        "circuit": { "$ref": "#/$defs/circuit" }
      }
    },
    "publication": {
      "type": "object",
      "required": ["id", "revision", "date", "auteur", "empreinte", "dossier"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" },
        "date": { "type": "string" },
        "auteur": { "type": "string" },
        "empreinte": { "type": "string", "description": "SHA-256 de la conception publiée." },
        "dossier": { "type": "string" },
        "derogation": { "type": "string" },
        "violations": { "type": "array", "items": { "type": "string" } },
        "fichiers": { "$ref": "#/$defs/chaines" }
      }
    },
    "cartouche": {
      "type": "object",
      "required": ["titre", "societe", "auteur", "revision", "date", "commentaire"],
      "properties": {
        "titre": { "type": "string" },
        "societe": { "type": "string" },
        "auteur": { "type": "string" },
        "revision": { "type": "string" },
        "date": { "type": "string" },
        "commentaire": { "type": "string" }
      }
    },
    "composant": {
      "type": "object",
      "required": ["uuid", "ref", "valeur", "symbole", "empreinte"],
      "properties": {
        "uuid": { "type": "string" },
        "ref": { "type": "string" },
        "valeur": { "type": "string" },
        "symbole": { "type": "string" },
        "empreinte": { "type": "string" },
        "fabricant": { "type": "string" },
        "mpn": { "type": "string" },
        "fournisseur": { "type": "string" },
        "description": { "type": "string" },
        "fiche": { "type": "string" },
        "nePasMonter": { "type": "boolean" },
        "horsCarte": { "type": "boolean" },
        "hauteur": { "type": "number", "exclusiveMinimum": 0, "description": "Hauteur saisie du corps, en millimètres." },
        "hauteurVerifiee": { "type": "boolean", "description": "Jusqu'à la 0.31 ; la 0.32 écrit provenanceHauteur." },
        "provenanceHauteur": { "enum": ["generique", "saisie", "fiche", "modele"], "description": "D'où vient la hauteur (0.32) ; absente : « saisie »." },
        "sourceHauteur": { "type": "string", "description": "Fiche, mesure ou modèle d'où vient la hauteur (0.32)." },
        "valeurLue": {
          "type": "object",
          "description": "La valeur comprise (0.32) : nombre dans l'unité de base de la famille, et cette unité.",
          "properties": { "nombre": { "type": "number" }, "unite": { "type": "string" } }
        },
        "formule": { "type": "string", "description": "Valeur calculée (0.32) : « 2*R1 », recalculée dans l'ordre des dépendances." },
        "parametres": { "$ref": "#/$defs/chaines", "description": "Paramètres typés de la famille (0.32) : tolérance, tension, puissance…" },
        "genre": { "enum": ["standard", "mecanique", "graphique", "liaisonReseaux", "horsNomenclature", "cavalier"], "description": "Type de composant (0.32) ; absent : « standard »." },
        "horsSimulation": { "type": "boolean", "description": "Exclu de la simulation (0.32)." },
        "brochageVerifie": { "type": "string", "description": "Empreinte dont le brochage a été vérifié (0.29)." },
        "article": { "type": "string", "description": "Article du projet dont le composant est tiré (0.33), avec sa version (versionArticle)." },
        "versionArticle": { "type": "integer" },
        "lcsc": { "type": "string", "description": "Code LCSC, repris dans la nomenclature (0.33)." },
        "modele3D": { "type": "string", "description": "Identifiant du modèle 3D exact (0.33)." },
        "modeleComposant": { "type": "string", "description": "Modèle SPICE propre au composant (0.33)." },
        "variantes": { "type": "object", "description": "Surcharges par variante de montage (0.33) : montage (monte, nonMonte), valeur, article, empreinte.", "additionalProperties": { "type": "object", "properties": { "montage": { "enum": ["monte", "nonMonte"] }, "valeur": { "type": "string" }, "article": { "type": "string" }, "empreinte": { "type": "string" } } } },
        "horsNomenclature": { "type": "boolean", "description": "0.29" },
        "horsPlacement": { "type": "boolean", "description": "0.29" },
        "champs": { "$ref": "#/$defs/chaines" }
      }
    },
    "feuille": {
      "type": "object",
      "required": ["uuid", "nom", "format", "symboles", "fils", "jonctions", "nonConnexions", "etiquettes", "textes"],
      "properties": {
        "uuid": { "type": "string" },
        "nom": { "type": "string" },
        "format": { "type": "string", "description": "Format du papier : A4, A3…" },
        "repetitions": { "type": "integer", "minimum": 2, "description": "Feuille de canal répétée N fois (0.33)." },
        "modele": { "type": "string", "description": "Feuille modèle dont celle-ci est une instance (0.33), avec son numéro (instance)." },
        "instance": { "type": "integer" },
        "symboles": { "type": "array", "items": { "$ref": "#/$defs/symbolePlace" } },
        "fils": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["uuid", "a", "b"],
            "properties": { "uuid": { "type": "string" }, "a": { "$ref": "#/$defs/point" }, "b": { "$ref": "#/$defs/point" } }
          }
        },
        "jonctions": { "type": "array", "items": { "$ref": "#/$defs/pointIdentifie" } },
        "nonConnexions": { "type": "array", "items": { "$ref": "#/$defs/pointIdentifie" } },
        "etiquettes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["uuid", "texte", "p", "rot", "globale"],
            "properties": {
              "uuid": { "type": "string" },
              "texte": { "type": "string" },
              "p": { "$ref": "#/$defs/point" },
              "rot": { "type": "integer" },
              "globale": { "type": "boolean" }
            }
          }
        },
        "textes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["uuid", "texte", "p", "taille"],
            "properties": {
              "uuid": { "type": "string" },
              "texte": { "type": "string" },
              "p": { "$ref": "#/$defs/point" },
              "taille": { "$ref": "#/$defs/nm" },
              "rot": { "type": "integer", "minimum": 0, "maximum": 3 }
            }
          }
        }
      }
    },
    "symbolePlace": {
      "type": "object",
      "required": ["uuid", "symbole", "p", "rot"],
      "properties": {
        "uuid": { "type": "string" },
        "symbole": { "type": "string" },
        "composant": { "type": "string" },
        "alim": { "type": "string" },
        "p": { "$ref": "#/$defs/point" },
        "rot": { "type": "integer", "minimum": 0, "maximum": 3, "description": "Quarts de tour." },
        "miroir": { "type": "boolean" },
        "unite": { "type": "integer", "minimum": 1 },
        "numeros": { "$ref": "#/$defs/chaines" }
      }
    },
    "defSymbole": {
      "type": "object",
      "required": ["id", "nom", "description", "categorie", "prefixe", "empreinte", "version", "posRef", "posVal", "broches", "traces"],
      "properties": {
        "id": { "type": "string" },
        "nom": { "type": "string" },
        "description": { "type": "string" },
        "categorie": { "type": "string" },
        "prefixe": { "type": "string" },
        "empreinte": { "type": "string" },
        "version": { "type": "integer" },
        "posRef": { "$ref": "#/$defs/point" },
        "posVal": { "$ref": "#/$defs/point" },
        "motsCles": { "type": "string" },
        "fabricant": { "type": "string" },
        "mpn": { "type": "string" },
        "fiche": { "type": "string" },
        "alimentation": { "type": "boolean" },
        "drapeau": { "type": "boolean" },
        "mecanique": { "type": "boolean" },
        "genre": { "enum": ["standard", "mecanique", "graphique", "liaisonReseaux", "horsNomenclature", "cavalier"], "description": "Type de composant que le symbole donne à sa pose (0.32)." },
        "unites": { "type": "integer", "minimum": 1 },
        "proprietes": { "$ref": "#/$defs/chaines" },
        "broches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["numero", "nom", "type", "p", "dir", "l", "nomVisible", "numeroVisible"],
            "properties": {
              "numero": { "type": "string" },
              "nom": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["entree", "sortie", "bidirectionnelle", "trois-etats", "passive", "alim-entree", "alim-sortie", "collecteur-ouvert", "non-connectee", "non-specifiee"]
              },
              "p": { "$ref": "#/$defs/point" },
              "dir": { "type": "integer", "minimum": 0, "maximum": 3 },
              "l": { "$ref": "#/$defs/nm" },
              "nomVisible": { "type": "boolean" },
              "numeroVisible": { "type": "boolean" },
              "unite": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["forme", "points"],
            "properties": {
              "forme": { "type": "integer", "minimum": 0, "maximum": 4 },
              "points": { "$ref": "#/$defs/points" },
              "rayon": { "$ref": "#/$defs/nm" },
              "debut": { "type": "number" },
              "fin": { "type": "number" },
              "rempli": { "type": "boolean" },
              "ferme": { "type": "boolean" },
              "fond": { "type": "boolean" },
              "texte": { "type": "string" },
              "taille": { "$ref": "#/$defs/nm" },
              "unite": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "defEmpreinte": {
      "type": "object",
      "required": ["id", "description", "famille", "version", "pastilles", "traits", "encombrement", "corps"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "famille": { "type": "string" },
        "version": { "type": "integer" },
        "pastilles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["numero", "type", "forme", "p", "l", "h"],
            "properties": {
              "numero": { "type": "string" },
              "type": { "type": "integer", "minimum": 0, "maximum": 2, "description": "0 CMS, 1 traversante, 2 non métallisée." },
              "forme": { "type": "integer", "minimum": 0, "maximum": 3, "description": "0 ronde, 1 rectangle, 2 ovale, 3 rectangle arrondi." },
              "p": { "$ref": "#/$defs/point" },
              "l": { "$ref": "#/$defs/nm" },
              "h": { "$ref": "#/$defs/nm" },
              "rot": { "type": "number" },
              "percage": { "$ref": "#/$defs/nm" },
              "arrondi": { "type": "number", "minimum": 0, "maximum": 0.5 },
              "couches": { "type": "array", "items": { "$ref": "#/$defs/couche" }, "description": "Couches explicites (0.29)." },
              "fab": { "type": "string", "description": "Propriété de fabrication (0.32), écrite en attribut .AperFunction du Gerber X2 : bga, fiducialLocal, fiducialGlobal, test, dissipateur, castellee." }
            }
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["couche", "a", "b", "ep"],
            "properties": {
              "couche": { "$ref": "#/$defs/couche" },
              "a": { "$ref": "#/$defs/point" },
              "b": { "$ref": "#/$defs/point" },
              "ep": { "$ref": "#/$defs/nm" },
              "rayon": { "$ref": "#/$defs/nm" }
            }
          }
        },
        "encombrement": { "type": "array", "items": { "$ref": "#/$defs/nm" }, "minItems": 4, "maxItems": 4 },
        "corps": {
          "type": "object",
          "required": ["l", "p", "h", "rond", "couleur"],
          "properties": {
            "l": { "$ref": "#/$defs/nm" },
            "p": { "$ref": "#/$defs/nm" },
            "h": { "$ref": "#/$defs/nm" },
            "rond": { "type": "boolean" },
            "couleur": { "type": "string" },
            "dx": { "$ref": "#/$defs/nm", "description": "Décalage du corps depuis l'origine de l'empreinte (0.32) : le centre de l'encombrement." },
            "dy": { "$ref": "#/$defs/nm" }
          }
        },
        "volumes": { "type": "array", "items": { "$ref": "#/$defs/volume" }, "description": "Volumes libres de l'empreinte (0.32)." }
      }
    },
    "volume": {
      "type": "object",
      "description": "Volume libre extrudé entre deux hauteurs (0.32).",
      "required": ["contour", "z0", "z1"],
      "properties": {
        "contour": { "$ref": "#/$defs/points" },
        "z0": { "$ref": "#/$defs/nm" },
        "z1": { "$ref": "#/$defs/nm" },
        "couleur": { "type": "string" }
      }
    },
    "circuit": {
      "type": "object",
      "required": ["contour", "empilage", "regles", "serigraphie", "fabrication", "empreintes", "pistes", "vias", "zones", "textes"],
      "properties": {
        "volumes": { "type": "array", "items": { "$ref": "#/$defs/volume" }, "description": "Volumes libres posés sur la carte (0.32)." },
        "contour": {
          "type": "object",
          "required": ["origine", "largeur", "hauteur", "rayon", "libre"],
          "properties": {
            "origine": { "$ref": "#/$defs/point" },
            "largeur": { "$ref": "#/$defs/nm" },
            "hauteur": { "$ref": "#/$defs/nm" },
            "rayon": { "$ref": "#/$defs/nm" },
            "libre": { "$ref": "#/$defs/points" },
            "decoupes": { "type": "array", "items": { "$ref": "#/$defs/points" } }
          }
        },
        "empilage": {
          "type": "object",
          "required": ["couches", "epaisseur", "cuivre", "materiau", "finition", "vernis", "serigraphie"],
          "properties": {
            "couches": { "type": "integer", "enum": [1, 2, 4] },
            "epaisseur": { "type": "number" },
            "cuivre": { "type": "number" },
            "materiau": { "type": "string" },
            "finition": { "type": "string" },
            "vernis": { "type": "string" },
            "serigraphie": { "type": "string" }
          }
        },
        "regles": { "$ref": "#/$defs/regles" },
        "serigraphie": {
          "type": "object",
          "required": ["reperes", "valeurs", "hauteur"],
          "properties": { "reperes": { "type": "boolean" }, "valeurs": { "type": "boolean" }, "hauteur": { "$ref": "#/$defs/nm" } }
        },
        "fabrication": {
          "type": "object",
          "required": ["margeVernis", "viasCouvertes", "tauxPate", "seuilPate"],
          "properties": {
            "margeVernis": { "$ref": "#/$defs/nm" },
            "viasCouvertes": { "type": "boolean" },
            "tauxPate": { "type": "number" },
            "seuilPate": { "type": "number" }
          }
        },
        "affichage": {
          "type": "object",
