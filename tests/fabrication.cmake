# Essai de bout en bout du dossier de fabrication (matrice FAB-01, audit E-14). L'outil écrit le dossier de la
# carte d'exemple et le contrôle ; puis deux lecteurs indépendants du code C++ le relisent : l'analyseur
# Python du dépôt (format, unités, origine, couches, trous, placement, nomenclature) et gerbv s'il est
# installé. Une copie volontairement abîmée doit être refusée, sans quoi l'analyseur ne prouverait rien.
file(REMOVE_RECURSE ${DOSSIER})
execute_process(COMMAND ${OUTIL} fabrication-exemple ${DOSSIER}/fab RESULT_VARIABLE r OUTPUT_VARIABLE sortie ERROR_VARIABLE erreurs)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "fabrication-exemple a rendu ${r}\n${sortie}\n${erreurs}")
endif()
file(GLOB gerbers ${DOSSIER}/fab/Gerber/*.gbr)
file(GLOB percages ${DOSSIER}/fab/Percage/*.drl)
list(LENGTH gerbers ng)
list(LENGTH percages np)
if(NOT ng EQUAL 9 OR NOT np EQUAL 2)
  message(FATAL_ERROR "dossier incomplet : ${ng} Gerber, ${np} perçages")
endif()

# Corpus de cartes d'essai (audit Q4) : chaque dossier est écrit et contrôlé par le noyau, puis relu plus bas par
# les mêmes lecteurs indépendants que la carte d'exemple, avec les faits attendus de sa conception
set(cartes "")
if(CORPUS)
  execute_process(COMMAND ${CORPUS} ${DOSSIER}/corpus ${DONNEES} RESULT_VARIABLE r OUTPUT_VARIABLE sortie ERROR_VARIABLE erreurs)
  message(STATUS "Corpus de cartes d'essai :\n${sortie}${erreurs}")
  if(NOT r EQUAL 0)
    message(FATAL_ERROR "corpus de cartes d'essai : écriture ou contrôle du noyau en défaut (${r})")
  endif()
  file(GLOB attendus ${DOSSIER}/corpus/*/attendu.txt)
  foreach(a ${attendus})
    get_filename_component(d ${a} DIRECTORY)
    list(APPEND cartes ${d})
  endforeach()
  list(LENGTH cartes nc)
  if(nc LESS 7)
    message(FATAL_ERROR "corpus incomplet : ${nc} cartes")
  endif()
endif()

if(PYTHON)
  set(attendu --couches 2 --trous-npth 4 --carte 50 32 --composants 9)
  execute_process(COMMAND ${PYTHON} -I ${SCRIPT} ${DOSSIER}/fab ${attendu} RESULT_VARIABLE r OUTPUT_VARIABLE sortie ERROR_VARIABLE erreurs)
  message(STATUS "Analyseur indépendant :\n${sortie}${erreurs}")
  if(NOT r EQUAL 0)
    message(FATAL_ERROR "l'analyseur indépendant refuse le dossier (${r})")
  endif()
  # Copies abîmées : unité changée, premier trou décalé hors de la carte, couches de perçage fausses ; liste de
  # réseaux aux vias décalées d'une colonne (F1) ou au code de vernis inversé ; gbrjob aux fonctions d'avant la 0.29
  foreach(defaut unite trou couches ipc-colonne ipc-vernis job-fonction)
    set(copie ${DOSSIER}/abime-${defaut})
    file(COPY ${DOSSIER}/fab/ DESTINATION ${copie})
    if(defaut STREQUAL "unite")
      file(GLOB f ${copie}/Gerber/*-F_Cu.gbr)
      file(READ ${f} t)
      string(REPLACE "%MOMM*%" "%MOIN*%" t "${t}")
    elseif(defaut STREQUAL "trou")
      file(GLOB f ${copie}/Percage/*-PTH.drl)
      file(READ ${f} t)
      string(REGEX REPLACE "\nT1\nX" "\nT1\nX1" t "${t}")
    elseif(defaut STREQUAL "couches")
      file(GLOB f ${copie}/Percage/*-PTH.drl)
      file(READ ${f} t)
      string(REPLACE "Plated,1,2,PTH" "Plated,1,4,PTH" t "${t}")
    elseif(defaut STREQUAL "ipc-colonne")
      file(GLOB f ${copie}/Test/*.ipc)
      file(READ ${f} t)
      string(REPLACE "VIA   -    MD" "VIA   -   MD" t "${t}")
    elseif(defaut STREQUAL "ipc-vernis")
      file(GLOB f ${copie}/Test/*.ipc)
      file(READ ${f} t)
      string(REGEX REPLACE "(327[^\n]*) S2" "\\1 S1" t "${t}")
    else()
      file(GLOB f ${copie}/Gerber/*.gbrjob)
      file(READ ${f} t)
      string(REPLACE "Soldermask," "SolderMask," t "${t}")
    endif()
    file(WRITE ${f} "${t}")
    execute_process(COMMAND ${PYTHON} -I ${SCRIPT} ${copie} ${attendu} RESULT_VARIABLE r OUTPUT_QUIET ERROR_VARIABLE erreurs)
    if(NOT r EQUAL 1)
      message(FATAL_ERROR "copie abîmée (${defaut}) acceptée par l'analyseur (${r})")
    endif()
    message(STATUS "Copie abîmée (${defaut}) refusée :\n${erreurs}")
  endforeach()
  foreach(d ${cartes})
    file(READ ${d}/attendu.txt arguments)
    string(STRIP "${arguments}" arguments)
    separate_arguments(arguments)
    get_filename_component(nom ${d} NAME)
    execute_process(COMMAND ${PYTHON} -I ${SCRIPT} ${d} ${arguments} RESULT_VARIABLE r OUTPUT_VARIABLE sortie ERROR_VARIABLE erreurs)
    message(STATUS "Analyseur indépendant, carte « ${nom} » :\n${sortie}${erreurs}")
    if(NOT r EQUAL 0)
      message(FATAL_ERROR "l'analyseur indépendant refuse le dossier de la carte « ${nom} » (${r})")
    endif()
  endforeach()
  if(GERBONARA)
    execute_process(COMMAND ${PYTHON} -I ${GERBONARA} ${DOSSIER}/fab ${cartes} RESULT_VARIABLE r OUTPUT_VARIABLE sortie ERROR_VARIABLE erreurs)
    message(STATUS "gerbonara :\n${sortie}${erreurs}")
    if(NOT r EQUAL 0)
      message(FATAL_ERROR "gerbonara refuse un dossier (${r})")
    endif()
  else()
    message(STATUS "gerbonara absent : troisième relecture sautée")
  endif()
else()
  message(STATUS "Python 3 absent : analyse indépendante sautée")
endif()

if(GERBV)
  # gerbv relit toutes les couches et en fait une image, pour la carte d'exemple et chaque carte du corpus. Les
  # versions antérieures à 2.7 ne connaissent pas les attributs X2 (%TF, %TA, %TO, %TD) et le disent : ce n'est pas
  # un défaut du fichier.
  foreach(d ${DOSSIER}/fab ${cartes})
    file(GLOB gerbers_d ${d}/Gerber/*.gbr)
    file(GLOB percages_d ${d}/Percage/*.drl)
    execute_process(COMMAND ${GERBV} -x png --dpi=300 -o ${d}/apercu.png ${gerbers_d} ${percages_d}
                    RESULT_VARIABLE r OUTPUT_QUIET ERROR_VARIABLE messages)
    string(REGEX REPLACE "[^\n]*Unknown RS-274X extension found %T[^\n]*" "" reste "${messages}")
    if(NOT r EQUAL 0 OR reste MATCHES "CRITICAL|ERROR")
      message(FATAL_ERROR "gerbv refuse le dossier ${d} (${r}) :\n${reste}")
    endif()
    if(NOT EXISTS ${d}/apercu.png)
      message(FATAL_ERROR "gerbv n'a pas produit d'image pour ${d}")
    endif()
    string(STRIP "${reste}" reste)
    message(STATUS "gerbv : ${d} relu, image écrite\n${reste}")
  endforeach()
else()
  message(STATUS "gerbv absent : relecture par gerbv sautée")
endif()
