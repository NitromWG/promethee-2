# Aide de l'atelier électronique (lot L2, tâches 2.11 et 2.17 ; ERG-13) : chaque code de règle que le noyau peut
# rendre (ERC, DRC, fabrication, intégrité, nomenclature, publication) a son explication « C'est quoi ? » dans
# AideElectronique.cpp. Les codes ELE de l'atelier électrique ont leur propre aide. L'échec nomme le code et le
# fichier du noyau qui le rend.
cmake_policy(SET CMP0057 NEW)
file(GLOB sources ${NOYAU}/src/*.cpp)
file(READ ${APP}/AideElectronique.cpp aide)
set(motif "\"(ERC|DRC|DFM|BOM|DOC|INT|PCB|VER)-[0-9]+\"")
set(vus "")
set(erreurs "")
foreach(f ${sources})
  get_filename_component(nom ${f} NAME)
  if(nom MATCHES "^electrique")
    continue()
  endif()
  file(STRINGS ${f} lignes REGEX "${motif}")
  foreach(l ${lignes})
    string(REGEX MATCHALL "${motif}" codes "${l}")
    foreach(c ${codes})
      string(REPLACE "\"" "" code "${c}")
      if(code IN_LIST vus)
        continue()
      endif()
      list(APPEND vus ${code})
      string(FIND "${aide}" "{\"${code}\"" pos)
      if(pos EQUAL -1)
        string(APPEND erreurs "${code} (rendu par ${nom}) n'a pas d'explication dans AideElectronique.cpp\n")
      endif()
    endforeach()
  endforeach()
endforeach()
list(LENGTH vus n)
if(n LESS 50)
  message(FATAL_ERROR "Seulement ${n} codes trouvés dans le noyau : la lecture du source est à revoir")
endif()
if(erreurs)
  message(FATAL_ERROR "${erreurs}")
endif()
message(STATUS "${n} codes du noyau, chacun expliqué")
